{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloElPrefijoUploads",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tienda-lab-123456789012",
      "Condition": { "StringLike": { "s3:prefix": ["uploads/*"] } }
    },
    {
      "Sid": "LeerYEscribirEnUploads",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::tienda-lab-123456789012/uploads/*"
    }
  ]
}
