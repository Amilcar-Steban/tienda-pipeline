{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginEnEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "SubirImagenesSoloATiendaApi",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-1:123456789012:repository/tienda-api"
    },
    {
      "Sid": "LeerDefinicionesDeTarea",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "RegistrarSoloLaFamiliaTiendaApi",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "arn:aws:ecs:us-east-1:123456789012:task-definition/tienda-api:*"
    },
    {
      "Sid": "ActualizarSoloElServicioApi",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:us-east-1:123456789012:service/tienda/api"
    },
    {
      "Sid": "PasarSoloLosRolesDeLaTareaAEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::123456789012:role/tienda-ecs-execution",
        "arn:aws:iam::123456789012:role/tienda-api-task"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "PublicarElFrontend",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::tienda-web-123456789012"
    },
    {
      "Sid": "EscribirObjetosDelFrontend",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::tienda-web-123456789012/*"
    },
    {
      "Sid": "InvalidarLaCacheDeCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::123456789012:distribution/E2ABC123EXAMPLE"
    }
  ]
}
